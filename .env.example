# Tu RUT sin puntos ni guión (ej: 123456789)
BANCOSECURITY_RUT=123456789
FALABELLA_RUT=123456789
BICE_RUT=123456789
SANTANDER_RUT=123456789
EDWARDS_RUT=123456789
BCI_RUT=123456789
ITAU_RUT=123456789
BANCOCHILE_RUT=123456789
BCHILE_RUT=123456789
SCOTIABANK_RUT=123456789
BESTADO_RUT=123456789
CENCOSUD_RUT=123456789
# Office Banking (empresas): RUT del usuario de acceso, no el de la empresa
SANTANDER_OFFICE_RUT=123456789

# Tu clave de internet del banco
BANCOSECURITY_PASS=tu_clave_aqui
FALABELLA_PASS=tu_clave_aqui
BICE_PASS=tu_clave_aqui
SANTANDER_PASS=tu_clave_aqui
EDWARDS_PASS=tu_clave_aqui
BCI_PASS=tu_clave_aqui
ITAU_PASS=tu_clave_aqui
BANCOCHILE_PASS=tu_clave_aqui
BCHILE_PASS=tu_clave_aqui
SCOTIABANK_PASS=tu_clave_aqui
BESTADO_PASS=tu_clave_aqui
CENCOSUD_PASS=tu_clave_aqui
SANTANDER_OFFICE_PASS=tu_clave_aqui

# Opcional [FALABELLA]: filtro TC por titular/adicional (T=titular, A=adicional, B=todos, default: B)
# FALABELLA_OWNER=B
# Opcional [SCOTIABANK]:
# SCOTIABANK_MONTHS=3
# Opcional [BCHILE]: segundos máximos para esperar aprobación manual de 2FA (default: 180)
# BCHILE_2FA_TIMEOUT_SEC=240
# Opcional [SANTANDER]: segundos máximos para esperar aprobación manual de 2FA (default: 180)
# SANTANDER_2FA_TIMEOUT_SEC=240
# Opcional [BCI]: segundos máximos para esperar aprobación manual de 2FA (default: 180)
# BCI_2FA_TIMEOUT_SEC=240
# Opcional [ITAU]: segundos máximos para esperar aprobación manual de 2FA Itaú Key (default: 180)
# ITAU_2FA_TIMEOUT_SEC=240
# Opcional [BICE]: cantidad de periodos historicos adicionales a consultar (default: 0 = solo mes actual). Debe ser un valor entre 1 y 16
# BICE_MONTHS=3
# Opcional [BANCOSECURITY]: cantidad de meses históricos adicionales a consultar vía Cartola histórica (default: 0 = solo periodo actual)
# BANCOSECURITY_MONTHS=3

# Opcional [CENCOSUD]: segundos máximos para resolver CAPTCHA manualmente en modo --headful (default: 180)
# CENCOSUD_CAPTCHA_TIMEOUT=180

# ─── Santander Office Banking (empresas, multi-RUT) ───────────────────
# Opcional: RUT de la empresa, solo si el login te lo pide además del RUT de usuario
# SANTANDER_OFFICE_COMPANY_RUT=761234567
# Opcional: limita a ciertos RUT mandatados (coma separada). Vacío = todos
# SANTANDER_OFFICE_RUTS=76086428-5,77123456-7
# Opcional: tope de RUT a recorrer (default: 20)
# SANTANDER_OFFICE_MAX_RUTS=20
# Opcional: tope de cuentas por RUT (default: 10)
# SANTANDER_OFFICE_MAX_ACCOUNTS=10
# Opcional: tope de páginas de cartola por cuenta (default: 25)
# SANTANDER_OFFICE_MAX_PAGES=25
# Opcional: segundos máximos para aprobar Santander Pass (default: 180)
# SANTANDER_OFFICE_2FA_TIMEOUT_SEC=240
# Opcional: entra a mano en la ventana de Chrome y el scraper sigue solo.
# El login del portal exige reCAPTCHA y rechaza el envío automático con HTTP 403,
# así que esto evita mandar tus credenciales a un endpoint que ya las rechaza.
# Requiere --headful.
# SANTANDER_OFFICE_MANUAL_LOGIN=1
# Opcional: segundos de espera para el login manual (default: 300)
# SANTANDER_OFFICE_MANUAL_TIMEOUT_SEC=300
# Opcional: fija la URL de login si el portal cambia de dirección
# SANTANDER_OFFICE_URL=https://www.officebanking.cl

# Opcional: ruta al ejecutable de Chrome/Chromium
# CHROME_PATH=/usr/bin/google-chrome-stable
